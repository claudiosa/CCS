/* 
Problem: EINSTEIN RIDDLES #1048
https://www.puzzleship.com/logic/einstein-riddles/p/2026-11-13#ultra-hard


Modeling Concepts: Hakan
Implementation: CCS
Apoio do Claude no predicado: quem() e saídas

*/
import cp.
main ?=> modelo.
main => printf("\n REVISE SEU modelo... regras etc\n").

modelo =>

  %%% MODELAGEM da ESTRUTURA DE DADOS 
  N = 5, %% 5 house (colors, , ....)

  Color = new_list(N),
  Color :: 1..N,
  Color = [Black, Green, Red, White, Yellow],
  Color_L = ["Black", "Green", "Red", "White", "Yellow"],
  Color_Map = list_to_map(Color_L),
  printf("\n %w", Color_Map), 

  Sport = new_list(N),
   Sport :: 1..N,
   Sport = [Baseball, Golf, Hockey, Swimming, Tennis],
   Sport_L = ["Baseball", "Golf", "Hockey", "Swimming", "Tennis"],
   Sport_Map = list_to_map(Sport_L),
   printf("\n %w", Sport_Map),

% Breakfast
Breakfast = new_list(N),
Breakfast :: 1..N,
Breakfast = [Cereal, Egg, Omelet, Pancake, Waffle],
Breakfast_L = ["Cereal", "Egg", "Omelet", "Pancake", "Waffle"],
Breakfast_Map = list_to_map(Breakfast_L),
printf("\n %w", Breakfast_Map),

%% Job
Job = new_list(N),
Job :: 1..N,
Job = [Builder, Chef, Doctor, Farmer, Policeman],
Job_L = ["Builder", "Chef", "Doctor", "Farmer", "Policeman"],
Job_Map = list_to_map(Job_L),
printf("\n %w", Job_Map),


%% Flower
Flower = new_list(N),
Flower :: 1..N,
Flower = [Bouquet, Hibiscus, Hyacinth, Lotus, Tulip],
Flower_L = ["Bouquet", "Hibiscus", "Hyacinth", "Lotus", "Tulip"],
Flower_Map = list_to_map(Flower_L),
printf("\n %w", Flower_Map),



%% Vegetable
Vegetable = new_list(N),
Vegetable :: 1..N,
Vegetable = [Corn, Eggplant, Onion, Pepper, Tomato],
Vegetable_L = ["Corn", "Eggplant", "Onion", "Pepper", "Tomato"],
Vegetable_Map = list_to_map(Vegetable_L),
printf("\n %w", Vegetable_Map),

%% Tree
Tree = new_list(N),
Tree :: 1..N,
Tree = [Bamboo, Maple, Oak, Palm, Spruce],
Tree_L = ["Bamboo", "Maple", "Oak", "Palm", "Spruce"],
Tree_Map = list_to_map(Tree_L),
printf("\n %w", Tree_Map),






%%%%%%%%%%%%%%%%%% Inicio das Restrições %%%%%%%%%%%%%%%%%%%%

%%% CODIGO para valer começa AQUI
%%% Restrições globais ... que são HARD-CONSTRAINTs
  %%% ALL DIFFERENT: cada item ocupa uma casa distinta
  all_different(Color),
  all_different(Sport),
  all_different(Breakfast),
  all_different(Job),
  all_different(Flower),
  all_different(Vegetable),
  all_different(Tree),


%% SEM SEQUENCIA ....


% 1. The house shaded by the Bamboo is directly to the left of the person who enjoys Waffle for breakfast.
 (Bamboo #= Waffle+1),

%2. The house with the Tulip is the house with the Spruce tree.
(Tulip #= Spruce),

%3. The man who enjoys Corn is immediately to the left of the Cereal fan.
(Corn #= 1 + Cereal),

% 4. The house with the Hyacinth is somewhere to the left of the person who loves Eggplant.
(Hyacinth #< Eggplant),

 %5. The person who plays Tennis is beside the Chef.
 ((Tennis #= Chef+1);(Tennis #= Chef-1)),

%6. The house with the Hibiscus is at one of the ends.
 ((Hibiscus #= 1);(Hibiscus #= 5)),

%7. The Black house is the house with the Bamboo tree.
(Black #= Bamboo),

%8. The person who plays Hockey is situated somewhere between the neighbor who loves Pancake for breakfast and the house shaded by the Palm, in that order.
%((Hockey #< Pancake),(Hockey #> Palm)), OR directly
 (Hockey #< Pancake #< Palm), %% in that order

%9. The one who loves Pancake for breakfast is immediately to the left of the Farmer.
(Pancake+1 #= Farmer),

%10. The Policeman is the man who loves Eggplant.
(Policeman #= Eggplant),

%11. The Tennis player is directly to the left of the person who enjoys Waffle for breakfast.
(Tennis #< Waffle),

%12. The person who loves Omelet for breakfast lives adjacent to the house with the Palm tree.
((Omelet + 1 #= Palm);(Omelet - 1 #= Palm)),

/* 
conferir Isso vale também para a dica 17, com Baseball, Eggplant e Onion.
 
13. The neighbor who loves Tomato is somewhere to the left of the Swimming player.
14. The person who loves Omelet for breakfast is the Policeman.
15. The man who plays Baseball is immediately to the left of the White house.
16. The Corn fan is immediately to the left of the Farmer.
17. The person who loves Eggplant is situated somewhere between the one who plays Baseball and the one who enjoys Onion, in that order.
18. The Doctor lives in the house with the Bouquet garden.
19. The house shaded by the Oak is somewhere to the right of the one who enjoys Tomato.
20. The man who plays Baseball lives in the Yellow house.
21. The Green house is the house with the Oak tree.
22. The Green house is the house with the Hyacinth garden.
23. The one who plays Swimming lives in the house with the Spruce tree.
24. The person who enjoys Corn is next to the person who plays Hockey.
*/


%%% passar ua lista para solver --- o SOLVER 
%%%%
    Vars = Color ++ Sport ++ Breakfast ++ Job ++ Flower ++ Vegetable ++ Tree,
    solve(Vars),

   nl,
%%% As saidas do Solver
%%% As saidas do Solver
  writeln(color=Color),
  writeln(sport=Sport),
  writeln(breakfast=Breakfast),
  writeln(job=Job),
  writeln(flower=Flower),
  writeln(vegetable=Vegetable),
  writeln(tree=Tree),

%println(Vars),
%%% Tornando-sa legível com o uso do mapa definido lá no inicio   
     printf("Solução:\n"),
  printf("\nHouse | Color | Sport | Breakfast | Job | Flower | Vegetable | Tree"),
  printf("\n----------------------------------------------------------------\n"),

  foreach(I in 1..N)
    printf("%w | ", I),
    printf("%w", get(Color_Map, quem(Color, I))),
    printf(" | "),
    printf("%w", get(Sport_Map, quem(Sport, I))),
    printf(" | "),
    printf("%w", get(Breakfast_Map, quem(Breakfast, I))),
    printf(" | "),
    printf("%w", get(Job_Map, quem(Job, I))),
    printf(" | "),
    printf("%w", get(Flower_Map, quem(Flower, I))),
    printf(" | "),
    printf("%w", get(Vegetable_Map, quem(Vegetable, I))),
    printf(" | "),
    printf("%w", get(Tree_Map, quem(Tree, I))),
    nl
  end,
  printf("----------------------------------------------------------------\n").
    

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%   
list_to_map(List) = MAP =>
  MAP = new_map(),
   foreach(Key in 1..List.length)
      put(MAP, Key, List[Key])
   end.
   %%% println(map=MAP).

%%% The Keys comes from L
print_map_from_L(L , Map) =>
   %List from map = keys(Map)
   foreach(Key in L)
      printf(" %w ", get(Map, Key))
   end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Devolve o índice K do item que tem o conteudo de um Valor I 
%% A função quem(L, I) devolve o índice K em que o valor I aparece na lista L. Esse K é o número do item (1 = primeiro nome, 2 = segundo nome, etc.), e é com ele que você consulta o mapa para obter o texto.
%% deste indice K se busca no mapa o objeto
quem(List, Value) = R =>
   nth(Index, List, Value),
   R = Index.

%%
