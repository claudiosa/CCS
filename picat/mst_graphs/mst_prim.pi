%%%

% remove da frente da fila as arestas cujo destino já está na árvore
drop_visited([(_,_,V)|Rest], Tree) = Q,
     membchk(V, Tree) =>
    Q = drop_visited(Rest, Tree).
drop_visited(Q, _) = Q => true.

%%priority_queue : push and pop
pop([ (_,_,V) | Rest ], New_V, New_Rest) => 
    New_V = V,
    New_Rest = Rest.

push( Neighbours, QP ) = NewQP =>
    TempQP = Neighbours ++ QP,
    NewQP = sort(TempQP).
    
%% Representing a map (graph), by tuples in an edges list 
edges_from_map(Graph) = Edges =>
    Edges = [(W, U, V) : U in keys(Graph), (V, W) in get(Graph, U), W != 0].

%%% get the neighbours of a specific Node
neighbours(Node, Graph) = Neighbours =>
    Neighbours = [(W, Node, V) : Node in keys(Graph), (V, W) in get(Graph, Node), W != 0].

%%%neighbours(Node, Graph) = [(W, Node, V) : (V, W) in get(Graph, Node)].


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
convert_Matrix_Map( M ) = Adj =>
    Nodes = M.length,
    Adj = new_map(),
    foreach (I in 1..Nodes)
        put(Adj,I,[(J , M[I,J]) : J in 1..Nodes, M[I,J] != 0 ])
        %printf("Adj %w",Adj)
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_Adj( G_Map ) =>
    L_Nodes = sort(keys(G_Map)), %% Sorting  for care ....
    foreach (Key in L_Nodes)
        printf("\n Node:%w : Adj: %w", Key, get(G_Map,Key) )
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


print_nodes(X_Matrix) =>
    N_ROWS = X_Matrix.length,
    N_COLS = X_Matrix.length,
    println("\nSolution -- SEQUENCE of NODES::"),
    println("-------------------"),
    foreach(I in 1.. N_ROWS)
        foreach(J in 1..N_COLS)
            if (X_Matrix[I,J] == 1) then
                printf("%d---%d\t",I,J)
            end
        end
    end,
    println("\n-------------------").
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_matrix( M ) =>
 L = M.length,
 C = M[1].length,
  nl,
   foreach(I in 1  .. L)
     foreach(J in 1  ..  C)
      %printf("X[%d][%d]: %d \t", I, J, M[I,J] )
      % print('x('), print(I),
      %print(','), write(J),
      %print(') = '),
      %write( M[I,J] ), print("    ")
      %% OR
       printf("X(%d,%d):%w   " , I, J, M[I,J] ) 
     end,
     nl
  end.    
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_m2( M ) =>
 L = M.length,
 C = M[1].length,
  nl,
   foreach(I in 1  .. L)
     foreach(J in 1  ..  C)
      %printf("X[%d][%d]: %d \t", I, J, M[I,J] )
      write( M[I,J] ), print("       ")
      %% printf("(%d,%d): %w " , I, J, M[I,J] ) -- FINE
     end,
     nl
  end.    
