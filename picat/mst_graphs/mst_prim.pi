Problem:
Find a minimum spanning tree (MST) of an undirected weighted graph.
Solved by CCS ... outputs,  some help from AI
*/
%import cp.
%import sat.
main ?=> input,
printf("\n....................................\n").
  
main => printf("\n  END (with some fail ... revise your code) \n").

input => 
    %% Data ... 
     Cost = {
        {0, 2, 5, 4, 0, 0, 0},   % O (1)
        {2, 0, 2, 1, 0, 0, 0},   % A (2)
        {5, 2, 0, 0, 3, 0, 0},   % B (3)
        {4, 1, 0, 0, 1, 4, 0},   % C (4)
        {0, 0, 3, 1, 0, 2, 5},   % D (5)
        {0, 0, 0, 4, 2, 0, 3},   % E (6)
        {0, 0, 0, 0, 5, 3, 0}    % T (7)
      },


  /*
   GRAPH  - Cap 9 
         2
   O -------- A
   |          |\
  5|         2| 1
   |          |   \
   B          C----?
    \         | \ 
     \3       |  4
      \       |   \
       D------      E ---- T
  */

    
    N = Cost.length,  %  -- ROWS - NODES
    %% DECISION MATRIX   
   % Graph = new_map(),   
    Graph = convert_Matrix_Map(Cost),
    print(Graph),
    print_Adj(Graph),
    Tuples_G = edges_from_map(Graph),
    printf("\n [(Weight, U, V)]: %w", Tuples_G),
    printf("\n Sorted [(Weight, U, V)]: %w", reverse(sort(Tuples_G))),
    Start = 1,
    printf("\n %w %w ", Start, neighbours(Start, Graph)  ),

    Tree :=  [Start],
    MST := [],
    QP := [],
    %Start = 1, %% any node could be choosen
    Neighbours = neighbours(Start, Graph), 
    QP := push( Neighbours, QP),
    foreach (I in 1..(N-1))
        QP := drop_visited(QP, Tree),
        [(W,U,V)|Rest] = QP,
        Tree := Tree ++ [V],
        MST  := MST ++ [(W,U,V)],
        QP   := push(neighbours(V, Graph), Rest)
       
    end,
    
    printf("\n Queue P %w", QP),    
   % printf("\t Tree %w", Tree),
    Total = sum([W : (W,_,_) in MST]),
    printf("\n Tree %w\n MST %w\n Custo %w", Tree, MST, Total)
    .
    %%%DOT
