/*
Problem:
Find a minimum spanning tree (MST) of an undirected weighted graph.
... outputs,
MST with Kruskal
From Problem Solving in Data Structures & Algorithms using Python, de Hemant Jain,
page 327
*/
%import cp.
%import sat.
main ?=> input,
printf("\n THE END OK \n....................................\n").

main => printf("\n  END (with some fail ... revise your code) \n").

input =>
    %% Data ...
    
     Cost = {
        {0, 2, 5, 4, 0, 0, 0},   % O (1)
        {2, 0, 2, 1, 0, 0, 0},   % A (2)
        {5, 2, 0, 0, 3, 0, 0},   % B (3)
        {4, 1, 0, 0, 1, 4, 0},   % C (4)
        {0, 0, 3, 1, 0, 2, 5},   % D (5)
        {0, 0, 0, 4, 2, 0, 3},   % E (6)
        {0, 0, 0, 0, 5, 3, 0}    % T (7)
      },

  /*
   GRAPH  - Cap 9
         2
   O -------- A
   |          |\\
  5|         2| 1
   |          |   \\
   B          C----?
    \\         | \\
     \\3       |  4
      \\       |   \\
       D------      E ---- T
  */
/*
Cost = {
    {0,  1, 0,  0},
    {1,  0, 3, 10},
    {0,  3, 0,  2},
    {0, 10, 2,  0}
    },
*/
    N = Cost.length,  %  -- ROWS - NODES
    Graph = convert_Matrix_Map(Cost),
    print(Graph),
    print_Adj(Graph),
    Tuples_G = edges_from_map(Graph),
    Edges := sort(Tuples_G),
    printf("\n [(Weight, U, V)]: %w", Tuples_G),
    printf("\n Sorted [(Weight, U, V)]: %w", Edges),

    MST  := [],

    while ( (length(MST)) < (N - 1) && length(Edges) > 0) do
        pop(Edges, Smallest_W, Rest),
        Edges := Rest,
        (W, U, V) = Smallest_W,
        % toma o topo da pilha ordenada por prioridade

        %%% Primeira aresta: sempre aceita
        if length(MST) == 0 then
            MST := MST ++ [(W,U,V)]
        %%% Teste de ciclo: aceita se NÃO fecha ciclo
        elseif not(would_cycle(MST, U, V)) then
            MST := MST ++ [(W,U,V)]
            else
              printf("\n Rejeitada: %w-%w (fecha ciclo)", U, V)
        end
    end,

    %%% OUTPUT
    Total = sum([W : (W,_,_) in MST]),
    Tree = sort([Nd : (_,A,B) in MST, Nd in [A,B]]),
    printf("\n Tree: %w \n MST: %w \n Custo: %w", Tree, MST, Total),
    print_MST_1(MST),
    print_MST_2(MST),
    print_MST_3(MST).
    %%%DOT

%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% CYCLE CHECK FOR KRUSKAL
%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%% Predicado: a aresta (U,V) fecharia um ciclo no MST em construção?
%%% Verdadeiro se V já é alcançável a partir de U usando só as arestas do MST.
would_cycle(MST, U, V) => reach_mst(MST, U, V, [U]).

%%% Versão função (para uso em expressões)
%would_cycle_f(MST, U, V) = reach_mst(MST, U, V, [U]).

%%% Busca em profundidade no grafo formado pelas arestas já aceitas.
%%% Visited evita revisitar nós (grafo não-direcionado: A-B conta nos dois sentidos).
reach_mst(_MST, X, Y, Visited) ?=> X == Y,
    printf("\n Reject or Closed => U: %w V: %w  Visited: %w", X, Y, Visited).
%%%% Condição de parada 
%% Ciclo recursivo    
reach_mst(MST, X, Y, Visited) =>
    Neigh = [NB : (_W,A,B) in MST,
                  ((A == X, NB = B) ; (B == X, NB = A)),
                   not membchk(NB, Visited)],
    member(N, Neigh), %%%% A partir de Neigh vai se gerar
    %%% os possíveis N por backtracking aqui.
    reach_mst(MST, N, Y, [N | Visited]).

%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_1( MST ) =>
    Size = length(MST),
    MST_Array = to_array(MST),
    printf("\n 1o. Printing MST graphically:\n"),
    foreach (I in 1..Size )
        (W,U,V) = MST_Array[I],
        printf(" %w<-->%w", U, V)
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_2( MST ) =>
    printf("\n 2o. Printing MST graphically:\n"),
    foreach( (W,U,V) in MST )
        printf(" %w<-->%w", U, V)
    end.
    %[  : (W,U,V) in MST, printf(" %w<-->%w", U, V)].

print_MST_3( MST ) =>
   printf("\n 3o. Printing MST graphically:\n"),
   _ = [_ : (_,U,V) in MST, printf(" %w<-->%w", U, V)],
   printf("\n Sum: %w", sum([W : (W,_,_) in MST ]) ).
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%priority_queue : push and pop
pop([(W,U,V) | Rest ], New, New_Rest) =>
    New = (W,U,V),
    New_Rest = [(W2,A,B) : (W2,A,B) in Rest, (A,B) != (V,U)].

push( Neighbours, QP ) = NewQP =>
    TempQP = Neighbours ++ QP,
    NewQP = sort(TempQP).

%% Representing a map (graph), by tuples in an edges list
edges_from_map(Graph) = Edges =>
    Edges = [(W, U, V) : U in keys(Graph), (V, W) in get(Graph, U), W != 0].
    %%% include U < V if you wish to improve the input

%%% get the neighbours of a specific Node
neighbours(Node, Graph) = Neighbours =>
    Neighbours = [(W, Node, V) : Node in keys(Graph), (V, W) in get(Graph, Node), W != 0].

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
convert_Matrix_Map( M ) = Adj =>
    Nodes = M.length,
    Adj = new_map(),
    foreach (I in 1..Nodes)
        put(Adj,I,[(J , M[I,J]) : J in 1..Nodes, M[I,J] != 0 ])
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_Adj( G_Map ) =>
    L_Nodes = sort(keys(G_Map)), %% Sorting  for care ....
    foreach (Key in L_Nodes)
        printf("\n Node:%w : Adj: %w", Key, get(G_Map,Key) )
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

