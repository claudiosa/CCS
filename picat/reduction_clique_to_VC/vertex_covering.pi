%% Vertex Cover
%% Cover all edges of the graph with the SMALLEST
%% possible number of selected vertices
import cp.

% ---------------------------------------------------------------
% Step 0: the graph G (vertices 1..N, edges as {U,V})
% ---------------------------------------------------------------
graph(5, [{1,2},{1,3},{2,3},{3,4},{3,5},{4,5}]).

main ?=>
    graph(N, Edges),
    printf("G: n = %d, Edges = %w", N, Edges),
    K_min = cover_vertex_MIN(N, Edges),
    printf("\n Size Covering Vertex (MIN): %w", K_min),
    Cs = all_cover_vertex(N, Edges, K_min),
    printf("\n Number of Min Covers Vertex: %d\n Here them:\n", length(Cs)),
    foreach(C in Cs)
        printf("  %w\n", C)
    end,

    %%% The min is calculated at the END.
    CS_2 = all_cover_vertex_2(N, Edges),
    printf("\n Number of Min Covers Vertex: %d\n Here them:\n", length(CS_2)),
    foreach(C in CS_2)
        printf("  %w\n", C)
    end
    .

main => printf("\n Please, revise your model").

% ---------------------------------------------------------------
%  Vertex Cover (VC) SOLVER modeled with CP
%   X[i] = 1 if vertex i is in the cover
%   every edge {i,j} needs X[i] + X[j] >= 1
%   the cover has exactly K vertices
% ---------------------------------------------------------------
cover_vertex_MIN(N, Edges) = K =>
    X = new_list(N),
    X :: 0..1,
    K_min :: 0..N,
    foreach({I,J} in Edges)
        X[I] + X[J] #>= 1
    end,
    sum(X) #= K_min,
    solve($[min(K_min)], X),
    %print(X),
    K=K_min.

%%%% when you now the  a MIN VERTEX
all_cover_vertex(N, Edges, K_min) = Covers =>
    X = new_list(N),
    X :: 0..1,
    foreach({I,J} in Edges) %%%% condition of covering
        X[I] + X[J] #>= 1
    end,
    sum(X) #= K_min, %%% only with this line
    Solutions = findall(X, solve(X)),
    Covers = [[I : I in 1..N, Sol[I] == 1] : Sol in Solutions].

%%%%% OPTION 2 --- findall sol and filter the shortests
all_cover_vertex_2(N, Edges) = Covers =>
    X = new_list(N),
    X :: 0..1,
    foreach({I,J} in Edges) %%%% condition of covering
        X[I] + X[J] #>= 1
    end,
    Solutions = solve_all([$sum(X)],X),
    %%% print(Solutions),
    % OR .... Solutions = findall(X, solve(X)),
    Shortest_of_All = shortest_lists(Solutions),
    Covers = [[I : I in 1..N, Sol[I] == 1] : Sol in Shortest_of_All].

%%%%%% Inspired by Claude
shortest_lists([]) = [].
shortest_lists(Lists) = Shortest =>
    K = min([sum(L) : L in Lists]),
    Shortest = [L : L in Lists, sum(L) == K].

