/*
From
Introduction to Operations Research (de Frederick S. Hillier e Gerald J. Lieberman)
 — .... Problem

Problem:
Find a minimum spanning tree (MST) of an undirected weighted graph.
The tree must connect all nodes using exactly N-1 edges while minimizing
the total cost of the selected edges.

Solution strategy:
The model uses an artificial flow to enforce connectivity.

One node is chosen as the root. Each of the other N-1 nodes sends one
unit of flow toward the root. Therefore, every non-root node has:

    output flow - input flow = 1

while the root receives all N-1 units:

    input flow - output flow = N-1

Flow is allowed only through selected edges. Thus, the selected edges
must form a connected structure. Since exactly N-1 edges are selected,
the connected structure is necessarily a spanning tree.

The objective is to minimize the total cost of the selected edges..

Solved by CCS ... outputs,  some help from AI
*/
import cp.
%import sat.
main ?=> model,
printf("\n....................................\n").
  
main => printf("\n  END (with some fail ... revise your code) \n").

model => 
    %% Data ... 
     Cost = {
        {0, 2, 5, 4, 0, 0, 0},   % O (1)
        {2, 0, 2, 1, 0, 0, 0},   % A (2)
        {5, 2, 0, 0, 3, 0, 0},   % B (3)
        {4, 1, 0, 0, 1, 4, 0},   % C (4)
        {0, 0, 3, 1, 0, 2, 5},   % D (5)
        {0, 0, 0, 4, 2, 0, 3},   % E (6)
        {0, 0, 0, 0, 5, 3, 0}    % T (7)
      },


  /*
   GRAPH  - Cap 9 
         2
   O -------- A
   |          |\
  5|         2| 1
   |          |   \
   B          C----?
    \         | \ 
     \3       |  4
      \       |   \
       D------      E ---- T
  */

    Start = 1, %% any node could be choosen
  
    N = Cost.length,  %  -- ROWS - NODES
    %% DECISION MATRIX      
    X = new_array(N, N), %% Row x Colun -- the edges choosen
    X :: 0..1, %%% DOMAIN
    %% DECISION MATRIX
    %% X[I,J] = 1 if arc I -> J is used
    %% X[I,J] = 0 otherwise
    Flow = new_array(N, N),
    Flow :: 0..(N-1), 
 
 %% Exactly (N-1) edges will be selected -- easy to verify
  (N-1) #= sum([ X[I,J] : I in 1..N, J in 1..N ]),
 
 %%%%% Intermediate nodes - flow balanced:  input - output = 0 
 %% all nodes should be reachable
 foreach(I in 1..N, I != Start)
    sum([Flow[I,J] : J in 1..N])
   - sum([Flow[J,I] : J in 1..N]) #= 1
  end,

  %%% the number of EDGES for N nodes ... 
  sum([Flow[J,Start] : J in 1..N]) 
   - sum([Flow[Start,J] : J in 1..N]) #= N-1,

  %%% Flow is in only one direction for edge (both or directional)
  foreach(I in 1..N, J in 1..N)
        Flow[J,I] #=< (N-1) * (X[I,J] + X[J,I])
   end,
  
  % EQUAL of this
  %foreach(I in 1..N, J in 1..N)
  %      Flow[I,J] #=< (N-1) * (X[I,J] + X[J,I])
  % end,


  %%% X[2,4] or X[4,2]  is seleted only once time
   foreach(I in 1..N, J in 1..N, I < J)
        (X[I,J] + X[J,I]) #=< 1
   end,


  %% A workaround or if COST = 0 then NO CONNECTION  Cost[I,J] = 0 ... no flow
  %% Therefore, arc I -> J cannot be selected
  foreach(I in 1..N, J in 1..N)
    if Cost[I,J] == 0 then
        X[I,J] #= 0
    end
  end,

  %% Cost function to be minimized
  Cost_F #= sum([Cost[I,J] * X[I,J] : 
                I in 1..N , 
                J  in 1..N]),
  
  %% Vars for search
  %Vars = [X_Matrix], 
  solve( $[ min(Cost_F) ], X ), %%% ++Flow ... but Flow, it is not solution
  
  printf("\n Input Data:"),
  print_m2(Cost), 

  printf("\nSolution Cost: %d" , Cost_F), %%  or %f
  
  print_nodes( X ), 
  print_matrix( X ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_nodes(X_Matrix) =>
    N_ROWS = X_Matrix.length,
    N_COLS = X_Matrix.length,
    println("\nSolution -- SEQUENCE of NODES::"),
    println("-------------------"),
    foreach(I in 1.. N_ROWS)
        foreach(J in 1..N_COLS)
            if (X_Matrix[I,J] == 1) then
                printf("%d---%d\t",I,J)
            end
        end
    end,
    println("\n-------------------").
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_matrix( M ) =>
 L = M.length,
 C = M[1].length,
  nl,
   foreach(I in 1  .. L)
     foreach(J in 1  ..  C)
      %printf("X[%d][%d]: %d \t", I, J, M[I,J] )
     % print('x('), print(I),
      %print(','), write(J),
      %print(') = '),
      %write( M[I,J] ), print("    ")
       printf("(%d,%d):%w   " , I, J, M[I,J] ) 
     end,
     nl
  end.    
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_m2( M ) =>
 L = M.length,
 C = M[1].length,
  nl,
   foreach(I in 1  .. L)
     foreach(J in 1  ..  C)
      %printf("X[%d][%d]: %d \t", I, J, M[I,J] )
      write( M[I,J] ), print("       ")
      %% printf("(%d,%d): %w " , I, J, M[I,J] ) -- FINE
     end,
     nl
  end.    
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%