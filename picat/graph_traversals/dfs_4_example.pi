    %%% DOT

%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% CYCLE DETECTION WITH DFS
%%%%%%%%%%%%%%%%%%%%%%%%%%%
dfs_cycle(Current_Node, End_Node, Visiteds, Edges_G, Sol) ?=>
    length(Visiteds) > 2,
    %% Several alternatives can be used here.
    %%% Use member/2 to force backtracking; it is not necessary in this case.
    membchk(Current_Node, neighbours(End_Node, Edges_G)),
    %%% End_Node represents the starting node.
    Sol = [End_Node|Visiteds]. %%%% Add the starting node to close the cycle; optional
    %%%%printf("\n A cycle has been found!").

dfs_cycle(Node, End_Node, Partial_Path, Edges_G, Sol) =>
   L_Candidates = remove_dups(neighbours(Node, Edges_G)), %%[V1, V2, ...]
   member(Next, L_Candidates), % Backtracking over this choice is essential.
   not membchk(Next, Partial_Path),
   %%%printf("\t %w => %w",Next, L_Candidates),
   append([Next], Partial_Path,  Path_New),
   %printf("\t %w",Path_New),
   dfs_cycle(Next, End_Node,  Path_New, Edges_G, Sol).

%%% Return the neighbors of node X, without edge weights.
neighbours(X, Edges) = [NB : (_,A,B) in Edges,
                       ((A == X, NB = B) ; (B == X, NB = A))].

%% Option 1 --- Calculate the weight of a path or any vertex sequence, including a cycle.
cycle_weight(S, Edges) = Total =>
    Total = sum([
        W : I in 1..S.length-1,
        U = S[I],
        V = S[I+1],
        (W,U1,V1) in Edges,
        ((U == U1, V == V1); (U == V1, V == U1))
    ]).

%% Option 2
cycle_weight_2([], _, S) ?=> S = 0.
cycle_weight_2([_], _, S) ?=> S = 0.
cycle_weight_2([A,B|L], Edges, Total) =>
    Temp = sum([W : (W,U,V) in Edges,
        ((U == A, V == B); (U == B, V == A))
            ]),
    cycle_weight_2([B|L], Edges, Rest),
    Total = Temp + Rest.

/*
%%%% OR
cycle_weight_2([A,B|L], Edges, Acc) =>
    Temp = sum([ W : (W,U,V) in Edges,
        ((U == A, V == B); (U == B, V == A))
    ]),
    Total = Temp + Acc,
    cycle_weight_2([B|L], Edges, Total).
*/

%% Option 3 -- My preferred approach.
cycle_weight_3(Sol, Edges) =
       sum([ W : (A,B) in Sol,
                 (W,U,V) in Edges,
                 ((U == A, V == B) ; (U == B, V == A))
                 ] ).

% OK
build_pairs([]) = [].
build_pairs([A]) = "\n Error build_pairs - ONLY ONE ELEMENT".
build_pairs([A,B]) = [(A,B)].
build_pairs([A,B | L]) =
         [ (A,B) | build_pairs([B|L]) ].

%%% An improved version of the above; this also works.
%% AN OPTION
%build_pairs([A,B|L]) = [(A,B) | build_pairs([B|L])].
%build_pairs(_) = [].

/*
%% This version also works.
build_pairs([A,B|L], Pairs) =>
    Pairs = [(A,B) | Rest],
    build_pairs([B|L], Rest).
build_pairs(_, Pairs) =>
    Pairs = [].
*/
%% This version also works.
pairs(L) = [(L[I], L[I+1]) : I in 1..length(L)-1].
%%% Get the neighbors of a specific node when the graph is represented as a map.
%neighbours(Node, Graph) = Neighbours =>
%    Neighbours = [(W, Node, V) : Node in keys(Graph), (V, W) in get(Graph, Node), W != 0].
%%%
%%% Not used directly here; included for Prim's and Kruskal's algorithms.
%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_1( MST ) =>
    Size = length(MST),
    MST_Array = to_array(MST),
    printf("\n 1. Displaying the MST graphically:\n"),
    foreach (I in 1..Size )
        (W,U,V) = MST_Array[I],
        printf(" %w<-%w->%w", U, W, V)
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_2( MST ) =>
    printf("\n 2. Displaying the MST graphically:\n"),
    foreach( (W,U,V) in MST )
        printf(" %w<-->%w", U, V)
    end.
    %[  : (W,U,V) in MST, printf(" %w<-->%w", U, V)].
print_MST_3( MST ) =>
   printf("\n 3. Displaying the MST graphically:\n"),
   _ = [_ : (_,U,V) in MST, printf(" %w<-->%w", U, V)],
   printf("\n Total weight: %w", sum([W : (W,_,_) in MST ]) ).
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Priority queue: push and pop
pop([(W,U,V) | Rest ], New, New_Rest) =>
    New = (W,U,V),
    New_Rest = [(W2,A,B) : (W2,A,B) in Rest, (A,B) != (V,U)].

push( Neighbours, QP ) = NewQP =>
    TempQP = Neighbours ++ QP,
    NewQP = sort(TempQP).
%% Represent a graph map as a list of edge tuples.
edges_from_map(Graph) = Edges =>
    Edges = [(W, U, V) : U in keys(Graph), (V, W) in get(Graph, U), W != 0].
    %%% Add U < V to avoid storing each undirected edge twice.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
convert_Matrix_Map( M ) = Adj =>
    Nodes = M.length,
    Adj = new_map(),
    foreach (I in 1..Nodes)
        put(Adj,I,[(J , M[I,J]) : J in 1..Nodes, M[I,J] != 0 ])
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_Adj( G_Map ) =>
    L_Nodes = sort(keys(G_Map)), %% Sort the node keys for consistent output.
    foreach (Key in L_Nodes)
        printf("\n Node: %w; adjacent nodes: %w", Key, get(G_Map,Key) )
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
