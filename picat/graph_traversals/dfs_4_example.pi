%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% CYCLE CHECKING with DFS 
%%%%%%%%%%%%%%%%%%%%%%%%%%%

dfs_cycle(Current_Node, End_Node, Visiteds, Edges_G, Sol) ?=>
    
    length(Visiteds) > 2,
    %%% use member to force the backtracking ....not necessary in this case
    membchk(Current_Node, neighbours(End_Node, Edges_G)),
    %%% End_Node ... means ... the Start node
    Sol = [End_Node|Visiteds]. %%%% Adding the initial node
    %%%%printf("\n Yes, we have a Cycle!").

dfs_cycle(Node, End_Node, Partial_Path, Edges_G, Sol) =>
       
   L_Candidates = remove_dups(neighbours(Node, Edges_G)), %%[V1, V2,......)] 
   member(Next, L_Candidates), % HERE ... obrigatory... we have backtracking over this part
   not membchk(Next, Partial_Path),
   %%%printf("\t %w => %w",Next, L_Candidates),
   append([Next], Partial_Path,  Path_New),
   %printf("\t %w",Path_New),
   dfs_cycle(Next, End_Node,  Path_New, Edges_G, Sol).

%%% Retorna a lista de vizinhos de X .... sem pesos sem nada
neighbours(X, Edges) = [NB : (_,A,B) in Edges,
                       ((A == X, NB = B) ; (B == X, NB = A))].


cycle_weight(S, Edges) = Total =>
    Total = sum([
        W : I in 1..S.length-1,
        U = S[I],
        V = S[I+1],
        (W,U1,V1) in Edges,
        ((U == U1, V == V1); (U == V1, V == U1))
    ]).


cycle_weight_2([], _, S) ?=> S = 0.
cycle_weight_2([_], _, S) ?=> S = 0.
/*
cycle_weight_2([A,B|L], Edges, Acc) =>
    Temp = sum([ W : (W,U,V) in Edges,
        ((U == A, V == B); (U == B, V == A))
    ]),
    Total = Temp + Acc,
    cycle_weight_2([B|L], Edges, Total).
*/


cycle_weight_2([A,B|L], Edges, Total) =>
    Temp = sum([W : (W,U,V) in Edges,
        ((U == A, V == B); (U == B, V == A))
            ]),
    cycle_weight_2([B|L], Edges, Rest),
    Total = Temp + Rest.

cycle_weight_3(Sol, Edges) = 
       sum([ W : (A,B) in Sol, 
                 (W,U,V) in Edges,
                 ((U == A, V == B) ; (U == B, V == A))
                 ] ).

% OK
build_pairs([]) = [].
build_pairs([A]) = "\n Error build_pairs - ONLY ONE ELEMENT".
build_pairs([A,B]) = [(A,B)].
build_pairs([A,B | L]) = 
         [ (A,B) | build_pairs([B|L]) ].


%%% Improved  of above and OK also
%build_pairs([A,B|L]) = [(A,B) | build_pairs([B|L])].
%build_pairs(_) = [].

/*
%%OK also
build_pairs([A,B|L], Pairs) =>
    Pairs = [(A,B) | Rest],
    build_pairs([B|L], Rest).
build_pairs(_, Pairs) =>
    Pairs = [].
*/
pairs(L) = [(L[I], L[I+1]) : I in 1..length(L)-1].

%%% get the neighbours of a specific Node but G is map
%neighbours(Node, Graph) = Neighbours =>
%    Neighbours = [(W, Node, V) : Node in keys(Graph), (V, W) in get(Graph, Node), W != 0].

%%% Predicado: a aresta (U,V) fecharia um ciclo no MST em construção?
%%% Verdadeiro se V já é alcançável a partir de U usando só as arestas do MST.

%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_1( MST ) =>
    Size = length(MST),
    MST_Array = to_array(MST),
    printf("\n 1o. Printing MST graphically:\n"),
    foreach (I in 1..Size )
        (W,U,V) = MST_Array[I],
        printf(" %w<-%w->%w", U, W, V)
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_MST_2( MST ) =>
    printf("\n 2o. Printing MST graphically:\n"),
    foreach( (W,U,V) in MST )
        printf(" %w<-->%w", U, V)
    end.
    %[  : (W,U,V) in MST, printf(" %w<-->%w", U, V)].

print_MST_3( MST ) =>
   printf("\n 3o. Printing MST graphically:\n"),
   _ = [_ : (_,U,V) in MST, printf(" %w<-->%w", U, V)],
   printf("\n Sum: %w", sum([W : (W,_,_) in MST ]) ).
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%priority_queue : push and pop
pop([(W,U,V) | Rest ], New, New_Rest) =>
    New = (W,U,V),
    New_Rest = [(W2,A,B) : (W2,A,B) in Rest, (A,B) != (V,U)].

push( Neighbours, QP ) = NewQP =>
    TempQP = Neighbours ++ QP,
    NewQP = sort(TempQP).

%% Representing a map (graph), by tuples in an edges list
edges_from_map(Graph) = Edges =>
    Edges = [(W, U, V) : U in keys(Graph), (V, W) in get(Graph, U), W != 0].
    %%% include U < V if you wish to improve the input
    
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
convert_Matrix_Map( M ) = Adj =>
    Nodes = M.length,
    Adj = new_map(),
    foreach (I in 1..Nodes)
        put(Adj,I,[(J , M[I,J]) : J in 1..Nodes, M[I,J] != 0 ])
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
print_Adj( G_Map ) =>
    L_Nodes = sort(keys(G_Map)), %% Sorting  for care ....
    foreach (Key in L_Nodes)
        printf("\n Node:%w : Adj: %w", Key, get(G_Map,Key) )
    end.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

